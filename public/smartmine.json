      "0": "待初审",
      "1": "已生成预警",
      "2": "初审无效"
    },
    "WarningEventStatus": {
      "0": "整改中",
      "1": "待审核",
      "2": "已整改"
    },
    "HazardWarningDisplayStatus": {
      "0": "待处理",
      "1": "待整改",
      "2": "待审核",
      "3": "已退回",
      "4": "已整改"
    },
    "WarningRectificationTaskType": {
      "0": "内业整改",
      "1": "外业整改"
    },
    "WarningRectificationTaskStatus": {
      "0": "待提交",
      "1": "已提交"
    },
    "WarningReviewResult": {
      "0": "通过",
      "1": "驳回"
    },
    "HazardSourceType": {
      "0": "设备上传",
      "1": "H5 移动端上报"
    },
    "WarningType": [
      "VehicleSafety",
      "PersonnelSafety",
      "BoundaryWarning",
      "EnvironmentalMonitoring",
      "SlopeMonitoring",
      "PlantControlWarning",
      "EquipmentSmartDispatchWarning"
    ]
  },
  "models": {
    "ApiResult": {
      "code": "number",
      "message": "string",
      "isSuccess": "boolean，只读，code == 200 时为 true",
      "timeStamp": "datetime",
      "data": "T"
    },
    "PagedList": {
      "pageIndex": "number",
      "pageSize": "number",
      "totalCount": "number",
      "totalPages": "number",
      "items": "T[]",
      "hasPrevPages": "boolean",
      "hasNextPages": "boolean"
    },
    "HazardListDto": {
      "id": "number",
      "title": "string",
      "code": "string",
      "hazardType": "number",
      "hazardLevel": "number：1蓝、2黄、3橙、4红",
      "status": "number：0待初审、1已生成预警、2初审无效",
      "displayStatus": "number|null：0待处理、1待整改、2待审核、3已退回、4已整改",
      "sourceType": "number：0设备、1移动端",
      "mineBasicInfoId": "number|null",
      "deviceId": "number|null",
      "sourceEventId": "string|null",
      "departmentId": "number|null",
      "location": "string|null",
      "hasWarning": "boolean",
      "warningEventId": "number|null",
      "createTime": "datetime",
      "updateTime": "datetime|null"
    },
    "HazardDetailDto": {
      "inherits": "HazardListDto",
      "description": "string|null",
      "longitude": "decimal|null",
      "latitude": "decimal|null",
      "altitude": "decimal|null",
      "rectificationRequirement": "string|null",
      "reviewUserId": "number|null",
      "rejectReason": "string|null",
      "createUserId": "number|null",
      "warning": "HazardWarningSummaryDto|null"
    },
    "HazardWarningSummaryDto": {
      "warningEventId": "number",
      "warningTitle": "string",
      "warningLevel": "number：1蓝、2黄、3橙、4红",
      "status": "number",
      "createTime": "datetime"
    },
    "WarningEventListDto": {
      "id": "number",
      "hazardId": "number",
      "hazardTitle": "string",
      "hazardCode": "string",
      "title": "string",
      "type": "string，预警分类字段保留但 Web/H5 不展示人工选择",
      "warningLevel": "number：1蓝、2黄、3橙、4红",
      "status": "number：0整改中、1待审核、2已整改",
      "displayStatus": "number：1待整改、2待审核、3已退回、4已整改",
      "taskCount": "number",
      "submittedTaskCount": "number",
      "createTime": "datetime",
      "updateTime": "datetime|null"
    },
    "WarningEventDetailDto": {
      "inherits": "WarningEventListDto",
      "message": "string",
      "rejectReason": "string|null",
      "tasks": "WarningRectificationTaskDto[]"
    },
    "WarningRectificationTaskDto": {
      "id": "number",
      "warningEventId": "number",
      "warningTitle": "string|null",
      "warningLevel": "number|null",
      "warningStatus": "number|null",
      "hazardId": "number|null",
      "hazardTitle": "string|null",
      "hazardCode": "string|null",
      "taskType": "number：0内业、1外业",
      "assignedToUserId": "number|null；内业任务为空，外业任务必填且可为内业或外业用户",
      "assignedToUserName": "string|null",
      "status": "number：0待提交、1已提交",
      "assignedByUserId": "number|null",
      "assignedTime": "datetime|null",
      "createTime": "datetime",
      "updateTime": "datetime|null"
    },
